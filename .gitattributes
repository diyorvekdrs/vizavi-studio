# the README's pictures are for GitHub only - keep them out of the download
/docs/ export-ignore
# tests and the CI setup are for development - keep them out of the download
/tests/ export-ignore
/.github/ export-ignore
# maintainer tools (publishing) are not part of the download
/dev/ export-ignore
# repository-only files at the ROOT only (a leading / – without it app/README.md was dropped too): not needed in the installer zip (it has READ ME FIRST.txt and Install Vizavi Studio.cmd)
/.gitattributes export-ignore
/.gitignore export-ignore
/README.md export-ignore
/get.ps1 export-ignore
/Vizavi-Studio-Installer.cmd export-ignore
